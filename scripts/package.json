{
  "name": "sipra-scripts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "simulate": "tsx ../test-tools/simulate-gps.ts",
    "e2e:handoff": "tsx ../test-tools/e2e-handoff.ts",
    "realtime:ingest": "tsx realtime-ingest.ts",
    "scenario": "tsx run-demo-scenario.ts",
    "scenario:happy": "tsx run-demo-scenario.ts --scenario=happy",
    "scenario:drone": "tsx run-demo-scenario.ts --scenario=drone",
    "play": "tsx play-scenario.ts",
    "play:s1-normal": "tsx play-scenario.ts --scenario=s1-normal --speed=10",
    "play:s2-congestion": "tsx play-scenario.ts --scenario=s2-congestion --speed=10",
    "play:s3-drone-handoff": "tsx play-scenario.ts --scenario=s3-drone-handoff --speed=10"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
